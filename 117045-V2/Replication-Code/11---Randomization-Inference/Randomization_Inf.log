. do Randomization_Inf 

. clear all

. 
. set seed 2020

. 
. use royal_obs_AEJ.dta

. 
. sort pair year

. 
. xtset pair year
       panel variable:  pair (unbalanced)
        time variable:  year, 1495 to 1918, but with gaps
                delta:  1 unit

. 
. capture drop invpath

. gen invpath=1/path
(57,511 missing values generated)

. replace invpath=0 if path==.
(53,616 real changes made)

. replace invpath=. if path==0
(0 real changes made)

. 
. est clear

. 
. *First load data and run:
. 
. egen ry1=concat(R1 year),punct("_")

. egen ry2=concat(R2 year),punct("_")

. 
. *Then save store the following program:
. 
. program placebo_sim, rclass
  1.         version 13
  2. 
.         capture drop death_placebo
  3.         capture drop coin
  4.         capture drop deathp5
  5. 
.         gen death_placebo=rbinomial(1,.00793)
  6.         gen coin=rbinomial(1,.5)
  7.         replace death_placebo=0 if path==.
  8.         
.         levelsof ry1 if coin==0 & death_placebo==1, local(treat1) clean
  9.         levelsof ry2 if coin==1 & death_placebo==1, local(treat2) clean
 10. 
.         foreach ry of local treat1{
 11.                 replace death_placebo=1 if ry1=="`ry'" | ry2=="`ry'"
 12.                 }
 13. 
.         foreach ry of local treat2{
 14.                 replace death_placebo=1 if ry1=="`ry'" | ry2=="`ry'"
 15.                 }
 16. 
.         replace death_placebo=0 if path==.
 17.         
.         gen deathp5=max(l.death_p,l2.death_p,l3.death_p,l4.death_p,l5.death_p
> )
 18. 
. set matsize 800
 19. 
. quietly reghdfe war adj blood same shared ln_dist (invpath=deathp5), a(year p
> air) old
 20. 
. end

. 
. *Finally run simulation:
. 
. parallel setclusters 12, f
N Clusters: 12
Stata dir:  /share/pkg.7/stata-se/16/install/stata

. 
. parallel sim, expr(_b[invpath]) reps(10000) saving(simout10kb): placebo_sim
